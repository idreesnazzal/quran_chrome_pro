{"k":"39:45","w":[{"t":"اشْمَأَزَّتْ","m":"نفرت وانقبضت عن التوحيد.","s":"SHJKNY"},{"t":"يَسْتَبْشِرُونَ","m":"يفرحون.","s":"Y"}]}
