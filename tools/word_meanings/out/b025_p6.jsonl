{"k":"39:22","w":[{"t":"شَرَحَ اللَّهُ صَدْرَهُ","m":"وسّع الله صدره لقبول الإسلام والإيمان به.","s":"Y"},{"t":"عَلَىٰ نُورٍ","m":"على بيان وهدى من ربه.","s":"Y"},{"t":"لِلْقَاسِيَةِ قُلُوبُهُمْ","m":"الذين قست قلوبهم وأعرضت عن ذكر الله.","s":"Y"}]}
{"k":"39:23","w":[{"t":"أَحْسَنَ الْحَدِيثِ","m":"أفضل الكلام وأبلغه، وهو القرآن.","s":"KY"},{"t":"مُتَشَابِهًا","m":"يشبه بعضه بعضًا في الحسن والإحكام.","s":"SNY"},{"t":"مَثَانِيَ","m":"تُكرّر فيه القصص والأحكام والمواعظ.","s":"SHJKNY"},{"t":"تَقْشَعِرُّ","m":"ترتعد وتضطرب خوفًا.","s":"SHKNY"},{"t":"تَلِينُ","m":"تسكن وتطمئن.","s":"SKY"}]}
{"k":"39:24","w":[{"t":"يَتَّقِي بِوَجْهِهِ","m":"يُلقى في النار مغلولًا، فيتلقى العذاب بوجهه.","s":"SY"},{"t":"سُوءَ الْعَذَابِ","m":"أشد العذاب وأسوأه.","s":"J"}]}
{"k":"39:25","w":[{"t":"مِنْ حَيْثُ لَا يَشْعُرُونَ","m":"من جهة لا يتوقعونها ولا يعلمون بها.","s":"Y"}]}
{"k":"39:26","w":[{"t":"الْخِزْيَ","m":"الذل والهوان.","s":"SKY"}]}
{"k":"39:27","w":[{"t":"ضَرَبْنَا لِلنَّاسِ","m":"بيّنّا لهم وذكرنا لهم.","s":"Y"},{"t":"مِنْ كُلِّ مَثَلٍ","m":"من كل صنف من أمثال الأمم الماضية.","s":"SY"}]}
{"k":"39:28","w":[{"t":"قُرْآنًا عَرَبِيًّا","m":"بلغة العرب، واضح الألفاظ سهل المعاني.","s":"Y"},{"t":"غَيْرَ ذِي عِوَجٍ","m":"لا اختلاف فيه ولا اضطراب ولا تناقض.","s":"SKY"}]}
{"k":"39:29","w":[{"t":"شُرَكَاءُ مُتَشَاكِسُونَ","m":"شركاء مختلفون متنازعون، يعسر إرضاؤهم.","s":"SHJKN"},{"t":"سَلَمًا لِرَجُلٍ","m":"خالصًا لرجل واحد لا يشركه فيه غيره.","s":"SHKN"}]}
{"k":"39:30","w":[]}
{"k":"39:31","w":[{"t":"تَخْتَصِمُونَ","m":"تتنازعون وتتحاجّون.","s":"Y"}]}
{"k":"39:32","w":[{"t":"بِالصِّدْقِ","m":"بالحق، أي القرآن والرسالة.","s":"SY"},{"t":"مَثْوًى","m":"مأوى ومسكن.","s":"SK"}]}
{"k":"39:33","w":[{"t":"جَاءَ بِالصِّدْقِ","m":"جاء بالحق، كالنبي محمد ومن قبله من الرسل.","s":"JY"},{"t":"وَصَدَّقَ بِهِ","m":"صدّق بالحق وآمن به وعمل بمقتضاه.","s":"JY"}]}
