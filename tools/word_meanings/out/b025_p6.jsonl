{"k":"39:55","w":[{"t":"أَحْسَنَ مَا أُنْزِلَ إِلَيْكُمْ","m":"أفضل ما أُنزل إليكم، وهو القرآن.","s":"Y"},{"t":"بَغْتَةً","m":"فجأة، على غفلة.","s":"SKY"}]}
