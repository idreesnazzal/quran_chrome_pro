{"k":"39:53","w":[{"t":"أَسْرَفُوا عَلَىٰ أَنْفُسِهِمْ","m":"تجاوزوا الحد في المعاصي.","s":"SKY"},{"t":"لَا تَقْنَطُوا","m":"لا تيأسوا.","s":"SKY"},{"t":"الذُّنُوبَ جَمِيعًا","m":"جميع الذنوب لمن تاب منها.","s":"KY"}]}
