{"k":"39:40","w":[{"t":"يُخْزِيهِ","m":"يُذلّه ويُهينه.","s":"SKY"},{"t":"يَحِلُّ عَلَيْهِ","m":"ينزل عليه ويجب عليه.","s":"KY"}]}
