{"k":"39:47","w":[{"t":"لَافْتَدَوْا بِهِ","m":"لبذلوه فداءً لينجوا من العذاب.","s":"Y"},{"t":"يَحْتَسِبُونَ","m":"يظنون ويتوقعون.","s":"SJK"}]}
{"k":"39:48","w":[{"t":"سَيِّئَاتُ مَا كَسَبُوا","m":"جزاء أعمالهم السيئة التي عملوها.","s":"Y"},{"t":"وَحَاقَ بِهِمْ","m":"أحاط بهم.","s":"SH"}]}
{"k":"39:49","w":[{"t":"خَوَّلْنَاهُ نِعْمَةً","m":"أعطيناه نعمة وتفضلنا عليه بها.","s":"SKY"},{"t":"أُوتِيتُهُ عَلَىٰ عِلْمٍ","m":"إنما أُعطيته لأني أهل له، وعندي علم بذلك.","s":"JY"},{"t":"فِتْنَةٌ","m":"ابتلاء واختبار.","s":"SKY"}]}
{"k":"39:50","w":[{"t":"فَمَا أَغْنَىٰ عَنْهُمْ","m":"لم يدفع عنهم شيئًا.","s":"Y"}]}
