{"k":"7:18","w":[{"t":"مَذْءُومًا","m":"ممقوتًا مذمومًا محتقرًا.","s":"SHKNY"},{"t":"مَدْحُورًا","m":"مطرودًا مبعدًا.","s":"SHKNY"}]}
