{"k":"6:151","w":[{"t":"أَتْلُ","m":"أقرأ عليكم.","s":"SK"},{"t":"إِمْلَاقٍ","m":"فقر وحاجة.","s":"SKHNY"},{"t":"الْفَوَاحِشَ","m":"كبائر الذنوب والمعاصي كالزنى ونحوه.","s":"JKY"},{"t":"مَا ظَهَرَ مِنْهَا","m":"ما كان منها علانية.","s":"JY"},{"t":"وَمَا بَطَنَ","m":"وما كان منها خفيًّا في السر.","s":"JY"},{"t":"بِالْحَقِّ","m":"بما يبيحه الشرع، كالقصاص من القاتل، أو رجم الزاني المحصن، أو قتل المرتد.","s":"Y"},{"t":"وَصَّاكُمْ","m":"أمركم وعهد إليكم به.","s":"KY"}],"x":["J:ألا تشركوا"]}
{"k":"6:152","w":[{"t":"بِالَّتِي هِيَ أَحْسَنُ","m":"بالطريقة التي تحفظ ماله وتنمّيه.","s":"JY"},{"t":"أَشُدَّهُ","m":"سنّ البلوغ وكمال قوته ورشده.","s":"SHKY"},{"t":"الْقِسْطِ","m":"العدل دون زيادة ولا نقص.","s":"SKY"},{"t":"وُسْعَهَا","m":"طاقتها وما تقدر عليه.","s":"K"},{"t":"فَاعْدِلُوا","m":"فتحرّوا العدل ولا تميلوا عن الحق.","s":"Y"},{"t":"ذَا قُرْبَىٰ","m":"صاحب قرابة منكم.","s":"JY"},{"t":"بِعَهْدِ اللَّهِ","m":"بما عهد الله به إليكم من الالتزام بشريعته.","s":"Y"}]}
{"k":"6:153","w":[{"t":"صِرَاطِي","m":"طريقي وديني الذي لا اعوجاج فيه، وهو الإسلام.","s":"KY"},{"t":"السُّبُلَ","m":"طرق الضلال والبدع المخالفة للإسلام.","s":"JY"},{"t":"فَتَفَرَّقَ بِكُمْ","m":"فتبعدكم وتفرّقكم وتضلكم.","s":"JY"}]}
{"k":"6:154","w":[{"t":"الْكِتَابَ","m":"التوراة.","s":"JY"},{"t":"تَمَامًا","m":"إتمامًا للنعمة على من أحسن من قوم موسى.","s":"JY"},{"t":"تَفْصِيلًا","m":"بيانًا مفصّلًا","s":"Y"},{"t":"بِلِقَاءِ رَبِّهِمْ","m":"بالبعث بعد الموت والحساب والجزاء.","s":"Y"}]}
{"k":"6:155","w":[{"t":"مُبَارَكٌ","m":"كثير الخير والنفع.","s":"Y"},{"t":"تُرْحَمُونَ","m":"تنالون رحمة الله فتنجون من عذابه.","s":"Y"}]}
{"k":"6:156","w":[{"t":"طَائِفَتَيْنِ","m":"فرقتين هما اليهود والنصارى.","s":"JY"},{"t":"دِرَاسَتِهِمْ","m":"قراءة كتبهم.","s":"SJY"},{"t":"لَغَافِلِينَ","m":"لاهين لا علم لنا بما فيها.","s":"JY"}]}
{"k":"6:157","w":[{"t":"أَهْدَىٰ","m":"أشد استقامة على طريق الحق.","s":"JY"},{"t":"بَيِّنَةٌ","m":"حجة واضحة.","s":"Y"},{"t":"صَدَفَ عَنْهَا","m":"أعرض عنها وصدّ الناس عنها.","s":"SJKY"},{"t":"سُوءَ الْعَذَابِ","m":"أشدّ العقاب.","s":"Y"}]}
