{"k":"7:7","w":[{"t":"فَلَنَقُصَّنَّ عَلَيْهِمْ","m":"فلنخبرنّهم بكل ما عملوه.","s":"Y"},{"t":"بِعِلْمٍ","m":"عن علم تام منا بأعمالهم.","s":"Y"}]}
{"k":"7:8","w":[{"t":"الْوَزْنُ","m":"وزن أعمال العباد.","s":"SY"},{"t":"الْحَقُّ","m":"العدل الذي لا ظلم فيه.","s":"SY"},{"t":"ثَقُلَتْ مَوَازِينُهُ","m":"رجحت حسناته على سيئاته.","s":"KY"},{"t":"الْمُفْلِحُونَ","m":"الفائزون.","s":"Y"}]}
{"k":"7:9","w":[{"t":"خَفَّتْ مَوَازِينُهُ","m":"رجحت سيئاته على حسناته.","s":"KY"},{"t":"خَسِرُوا أَنْفُسَهُمْ","m":"غبنوها وأضاعوا حظهم من رضوان الله.","s":"HY"},{"t":"يَظْلِمُونَ","m":"يجحدون ويتجاوزون الحد فلا ينقادون لها.","s":"Y"}]}
