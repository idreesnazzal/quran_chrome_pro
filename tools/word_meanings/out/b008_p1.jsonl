{"k":"6:161","w":[{"t":"صِرَاطٍ مُسْتَقِيمٍ","m":"طريق واضح لا اعوجاج فيه، وهو الإسلام.","s":"NY"},{"t":"قِيَمًا","m":"قائمًا مستقيمًا ثابتًا، يقوم بمصالح الدنيا والآخرة.","s":"SHJKY"},{"t":"مِلَّةَ إِبْرَاهِيمَ","m":"دين إبراهيم، وهو التوحيد.","s":"HY"},{"t":"حَنِيفًا","m":"مائلًا عن الشرك إلى التوحيد.","s":"SKY"}]}
