{"k":"7:4","w":[{"t":"بَأْسُنَا","m":"عذابنا.","s":"SJKY"},{"t":"بَيَاتًا","m":"ليلًا وهم نائمون.","s":"SHKNY"},{"t":"هُمْ قَائِلُونَ","m":"نائمون وقت القيلولة في نصف النهار.","s":"SHJKNY"}]}
