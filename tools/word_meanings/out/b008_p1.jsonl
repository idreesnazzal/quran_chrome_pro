{"k":"6:159","w":[{"t":"فَرَّقُوا دِينَهُمْ","m":"جعلوا دينهم فرقًا مختلفة بعد أن كانوا مجتمعين عليه.","s":"JY"},{"t":"شِيَعًا","m":"فرقًا وأحزابًا.","s":"SKNY"},{"t":"لَسْتَ مِنْهُمْ فِي شَيْءٍ","m":"أنت بريء منهم.","s":"JY"},{"t":"أَمْرُهُمْ","m":"حكمهم وحسابهم.","s":"Y"}]}
