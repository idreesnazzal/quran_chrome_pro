{"k":"7:136","w":[{"t":"فَانْتَقَمْنَا","m":"عاقبناهم.","s":"Y"},{"t":"الْيَمِّ","m":"البحر.","s":"SHNY"},{"t":"غَافِلِينَ","m":"لاهين لا يتأملون فيها.","s":"Y"}]}
{"k":"7:137","w":[{"t":"أَوْرَثْنَا","m":"ملّكنا وأعطينا.","s":"Y"},{"t":"يُسْتَضْعَفُونَ","m":"يُذلّون ويُستخدمون.","s":"Y"},{"t":"مَشَارِقَ الْأَرْضِ وَمَغَارِبَهَا","m":"بلاد الشام.","s":"SJY"},{"t":"بَارَكْنَا فِيهَا","m":"أكثرنا فيها الخير بالماء والشجر والزروع.","s":"JY"},{"t":"كَلِمَتُ رَبِّكَ الْحُسْنَىٰ","m":"وعده الحسن لهم بالتمكين في الأرض.","s":"Y"},{"t":"دَمَّرْنَا","m":"أهلكنا وخرّبنا.","s":"HJKY"},{"t":"يَعْرِشُونَ","m":"يبنون ويرفعون من الأبنية.","s":"SHJKNY"}]}
