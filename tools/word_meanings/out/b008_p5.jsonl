{"k":"7:142","w":[{"t":"وَوَاعَدْنَا","m":"حدّدنا له موعدًا للمناجاة.","s":"Y"},{"t":"بِعَشْرٍ","m":"بعشر ليالٍ زيادة عليها.","s":"Y"},{"t":"مِيقَاتُ","m":"الوقت المحدد.","s":"NY"},{"t":"اخْلُفْنِي","m":"كن خليفتي فيهم.","s":"Y"},{"t":"أَصْلِحْ","m":"احمل قومك على الطاعة والعمل الصالح.","s":"Y"}]}
{"k":"7:143","w":[{"t":"لِمِيقَاتِنَا","m":"للوقت الذي حددناه له.","s":"SY"},{"t":"أَرِنِي أَنْظُرْ إِلَيْكَ","m":"اجعلني أراك وأنظر إليك.","s":"Y"},{"t":"لَنْ تَرَانِي","m":"لن تقدر على رؤيتي في الدنيا.","s":"JY"},{"t":"تَجَلَّىٰ","m":"ظهر وبان.","s":"HNY"},{"t":"دَكًّا","m":"مستويًا بالأرض مفتَّتًا.","s":"HKNY"},{"t":"صَعِقًا","m":"مغشيًّا عليه.","s":"SHJKY"},{"t":"سُبْحَانَكَ","m":"تنزيهًا لك عما لا يليق بجلالك.","s":"KY"},{"t":"تُبْتُ إِلَيْكَ","m":"رجعت إليك من سؤال لم تأذن لي فيه.","s":"JY"}]}
