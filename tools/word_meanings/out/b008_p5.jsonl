{"k":"7:140","w":[{"t":"أَبْغِيكُمْ","m":"أطلب لكم.","s":"KY"},{"t":"فَضَّلَكُمْ عَلَى الْعَالَمِينَ","m":"فضّلكم على عالمي زمانكم.","s":"NY"}]}
