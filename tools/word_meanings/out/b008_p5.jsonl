{"k":"7:145","w":[{"t":"الْأَلْوَاحِ","m":"ألواح التوراة.","s":"SJKY"},{"t":"مَوْعِظَةً","m":"ما يُزجر ويُعتبر به.","s":"Y"},{"t":"تَفْصِيلًا","m":"بيانًا مفصّلًا.","s":"Y"},{"t":"بِقُوَّةٍ","m":"بجد واجتهاد.","s":"JY"},{"t":"بِأَحْسَنِهَا","m":"بأفضل ما فيها من الأحكام، كالعفو والصبر.","s":"J"},{"t":"دَارَ الْفَاسِقِينَ","m":"جهنم التي أعدّها الله للخارجين عن طاعته.","s":"Y"}]}
