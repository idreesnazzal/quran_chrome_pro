{"k":"39:3","w":[{"t":"الدِّينُ الْخَالِصُ","m":"الطاعة التامة السالمة من الشرك.","s":"SY"},{"t":"أَوْلِيَاءَ","m":"آلهة يتخذونها من دون الله.","s":""},{"t":"زُلْفَىٰ","m":"تقرّبًا ومنزلة.","s":"SHKNY"},{"t":"كَاذِبٌ كَفَّارٌ","m":"مفترٍ على الله، كفّار بآياته.","s":"Y"}]}
