{"k":"39:8","w":[{"t":"مُنِيبًا إِلَيْهِ","m":"راجعًا إليه، مستغيثًا به.","s":"SKY"},{"t":"خَوَّلَهُ نِعْمَةً","m":"أعطاه نعمة وتفضّل عليه بها.","s":"SKNY"},{"t":"أَنْدَادًا","m":"شركاء وأمثالًا يعبدونها.","s":"SKY"},{"t":"تَمَتَّعْ بِكُفْرِكَ قَلِيلًا","m":"تمتّع بكفرك مدة قليلة حتى الموت.","s":"Y"}]}
{"k":"39:9","w":[{"t":"قَانِتٌ","m":"مطيع خاضع لله، عابد.","s":"SKY"},{"t":"آنَاءَ اللَّيْلِ","m":"ساعات الليل.","s":"SKY"},{"t":"يَحْذَرُ الْآخِرَةَ","m":"يخاف عذاب الآخرة.","s":"Y"}]}
