{"k":"39:17","w":[{"t":"اجْتَنَبُوا الطَّاغُوتَ","m":"ابتعدوا عن كل معبود من دون الله، من أوثان وشياطين.","s":"SJKY"},{"t":"أَنَابُوا إِلَى اللَّهِ","m":"رجعوا إلى الله بالتوبة والطاعة.","s":"SKY"},{"t":"الْبُشْرَىٰ","m":"الثناء الحسن والتوفيق في الدنيا، والجنة في الآخرة.","s":"SY"}]}
