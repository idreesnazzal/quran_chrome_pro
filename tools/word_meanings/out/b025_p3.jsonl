{"k":"38:18","w":[{"t":"سَخَّرْنَا الْجِبَالَ مَعَهُ","m":"ذللنا الجبال لداود فتسبّح معه.","s":"Y"},{"t":"بِالْعَشِيِّ","m":"آخر النهار، ما بعد الزوال إلى الغروب.","s":"SK"},{"t":"وَالْإِشْرَاقِ","m":"أول النهار، وقت الضحى.","s":"SK"}]}
{"k":"38:19","w":[{"t":"مَحْشُورَةً","m":"مجموعة إليه تسبّح معه.","s":"S"},{"t":"أَوَّابٌ","m":"مطيع لله، يرجع إليه بالتسبيح.","s":"SH"}]}
{"k":"38:20","w":[{"t":"وَشَدَدْنَا مُلْكَهُ","m":"قوّيناه بالهيبة والنصر.","s":"SKY"},{"t":"الْحِكْمَةَ","m":"النبوة.","s":"SJKY"},{"t":"فَصْلَ الْخِطَابِ","m":"البيان الفاصل بين الحق والباطل، والقضاء الفصل.","s":"SJKY"}]}
{"k":"38:21","w":[{"t":"نَبَأُ الْخَصْمِ","m":"خبر المتخاصمين.","s":"SY"},{"t":"تَسَوَّرُوا الْمِحْرَابَ","m":"صعدوا سور مكان عبادته ثم نزلوا إليه.","s":"HK"}]}
{"k":"38:22","w":[{"t":"فَفَزِعَ مِنْهُمْ","m":"فخاف منهم وارتاع.","s":"SY"},{"t":"بَغَىٰ بَعْضُنَا عَلَىٰ بَعْضٍ","m":"ظلم بعضنا بعضًا وتعدّى عليه.","s":"KY"},{"t":"وَلَا تُشْطِطْ","m":"لا تجُرْ في حكمك ولا تبعد عن الحق.","s":"SHKNY"},{"t":"سَوَاءِ الصِّرَاطِ","m":"وسط الطريق المستقيم، أي الحق.","s":"SHKNY"}]}
{"k":"38:23","w":[{"t":"نَعْجَةً","m":"الأنثى من الضأن.","s":""},{"t":"أَكْفِلْنِيهَا","m":"أعطنيها وانزل لي عنها.","s":"SHJKNY"},{"t":"وَعَزَّنِي فِي الْخِطَابِ","m":"وغلبني في الكلام والمحاجّة.","s":"SHKNY"}]}
{"k":"38:24","w":[{"t":"الْخُلَطَاءِ","m":"الشركاء في المال.","s":"SHJKY"},{"t":"لَيَبْغِي","m":"ليعتدي ويظلم.","s":"SY"},{"t":"وَظَنَّ","m":"أيقن.","s":"SJY"},{"t":"فَتَنَّاهُ","m":"ابتليناه واختبرناه.","s":"SJKY"},{"t":"وَخَرَّ رَاكِعًا","m":"سقط ساجدًا لله تعالى.","s":"SJKY"},{"t":"وَأَنَابَ","m":"رجع إلى الله بالتوبة.","s":"SKY"}]}
{"k":"38:25","w":[{"t":"لَزُلْفَىٰ","m":"قربى ومكانة عندنا.","s":"SKY"},{"t":"وَحُسْنَ مَآبٍ","m":"حسن المرجع في الآخرة، وهو الجنة.","s":"SKY"}]}
{"k":"38:26","w":[{"t":"خَلِيفَةً","m":"جعلناك ملكًا ونائبًا عنا في الأرض.","s":"Y"},{"t":"الْهَوَىٰ","m":"ما تميل إليه النفس.","s":"Y"},{"t":"بِمَا نَسُوا يَوْمَ الْحِسَابِ","m":"بسبب غفلتهم عن يوم الحساب.","s":"Y"}]}
{"k":"38:27","w":[{"t":"بَاطِلًا","m":"عبثًا لا حكمة فيه.","s":"SJKY"},{"t":"فَوَيْلٌ","m":"هلاك وعذاب، وقيل: واد في جهنم.","s":"SKY"}]}
{"k":"38:28","w":[{"t":"الْمُتَّقِينَ","m":"الذين يتقون الله بطاعته واجتناب معاصيه.","s":"Y"},{"t":"الْفُجَّارِ","m":"الكفار المنهمكون في المعاصي.","s":"Y"}]}
{"k":"38:29","w":[{"t":"مُبَارَكٌ","m":"كثير الخير والنفع.","s":""},{"t":"لِيَدَّبَّرُوا","m":"ليتفكروا فيه ويتدبروا معانيه.","s":"Y"},{"t":"أُولُو الْأَلْبَابِ","m":"أصحاب العقول السليمة.","s":"Y"}]}
{"k":"38:30","w":[{"t":"نِعْمَ الْعَبْدُ","m":"ما أفضله عبدًا لله.","s":"Y"},{"t":"أَوَّابٌ","m":"كثير الرجوع إلى الله بالتوبة.","s":"SK"}]}
{"k":"38:31","w":[{"t":"بِالْعَشِيِّ","m":"وقت العصر، ما بعد الزوال إلى الغروب.","s":"SK"},{"t":"الصَّافِنَاتُ","m":"الخيول الواقفة على ثلاث قوائم، ترفع الرابعة.","s":"SKJY"},{"t":"الْجِيَادُ","m":"الخيول الأصيلة السريعة.","s":"SKY"}]}
{"k":"38:32","w":[{"t":"حُبَّ الْخَيْرِ","m":"حب المال، وقيل: حب الخيل.","s":"SYHJK"},{"t":"عَنْ ذِكْرِ رَبِّي","m":"عن صلاة العصر وذكر الله.","s":"KY"},{"t":"تَوَارَتْ بِالْحِجَابِ","m":"غابت الشمس عن الأبصار.","s":"SKY"}]}
{"k":"38:33","w":[{"t":"رُدُّوهَا عَلَيَّ","m":"أعيدوا الخيل عليّ.","s":"KY"},{"t":"فَطَفِقَ","m":"شرع يفعل ذلك.","s":"SY"},{"t":"مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ","m":"يمسح سيقانها وأعناقها، وقيل: يقطعها بالسيف تقربًا لله.","s":"SJY"}]}
{"k":"38:34","w":[{"t":"فَتَنَّا سُلَيْمَانَ","m":"ابتليناه واختبرناه.","s":"SKY"},{"t":"جَسَدًا","m":"شِقّ إنسان ولد له، وقيل: شيطان.","s":"SKJY"},{"t":"أَنَابَ","m":"رجع إلى الله بالتوبة.","s":"SKY"}]}
{"k":"38:35","w":[{"t":"مُلْكًا لَا يَنْبَغِي","m":"ملكًا خاصًا لا يكون مثله لأحد بعدي.","s":"Y"}]}
{"k":"38:36","w":[{"t":"رُخَاءً","m":"لينة طيعة لا تعصف.","s":"SJKNY"},{"t":"حَيْثُ أَصَابَ","m":"حيث أراد.","s":"SHKNY"}]}
{"k":"38:37","w":[{"t":"كُلَّ بَنَّاءٍ وَغَوَّاصٍ","m":"كل بنّاء، وغوّاص يستخرج نفائس البحر.","s":"KY"}]}
{"k":"38:38","w":[{"t":"مُقَرَّنِينَ فِي الْأَصْفَادِ","m":"موثوقين في الأغلال، تُجمع أيديهم إلى أعناقهم.","s":"SKY"}]}
{"k":"38:39","w":[{"t":"فَامْنُنْ أَوْ أَمْسِكْ","m":"فأعط من شئت أو امنع من شئت.","s":"SJY"},{"t":"بِغَيْرِ حِسَابٍ","m":"دون محاسبة ولا حرج.","s":"KY"}]}
{"k":"38:40","w":[{"t":"لَزُلْفَىٰ","m":"قربى ومكانة وكرامة.","s":"SKY"},{"t":"وَحُسْنَ مَآبٍ","m":"حسن المرجع في الآخرة.","s":"SKY"}]}
